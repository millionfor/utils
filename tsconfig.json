{
  "transpileOnly": true,
  "compilerOptions": {
    "declaration": true,
    "esModuleInterop": true,
    "moduleResolution": "node",
    "module": "esnext",
    "target": "esnext",
    "outDir": "./dist",
    "newLine": "lf",
    "types": ["node", "jest"],
    "allowJs": true,
    "allowSyntheticDefaultImports": true,
    "removeComments": true,
    "diagnostics": true,
    "downlevelIteration": false,
    "baseUrl": ".",
    "resolveJsonModule": true,
    "noEmitOnError": false,
    "noImplicitAny": false,
    "noImplicitThis": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "pretty": true,
    "skipLibCheck": true
  },
  "include": ["**/*.ts"],
  "exclude": ["dist", "node_modules", "test/typescript"]
}
