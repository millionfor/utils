{
  "name": "@millionfor/utils",
  "description": "A Typescript based Node Development Tool Library.",
  "version": "1.0.6-dev.1",
  "author": "QuanQuan <millionfor@apache.org>",
  "main": "dist/index.cjs.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git@github.com/millionfor/utils.git"
  },
  "scripts": {
    "build": "rb -c",
    "watch": "rb -c -w",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "testx": "echo 'test'",
    "test": "jest"
  },
  "dependencies": {
    "console-log-colors": "^0.5.0",
    "try-catch": "^3.0.0"
  },
  "devDependencies": {
    "@allex/rollup-plugin-node-globals": "^0.0.2",
    "@babel/core": "^7.5.5",
    "@babel/plugin-external-helpers": "latest",
    "@babel/plugin-syntax-import-meta": "^7.10.4",
    "@babel/plugin-syntax-jsx": "^7.2.0",
    "@babel/plugin-transform-flow-strip-types": "^7.4.4",
    "@babel/plugin-transform-react-jsx": "^7.3.0",
    "@babel/plugin-transform-runtime": "latest",
    "@babel/preset-env": "^7.5.5",
    "@babel/preset-flow": "^7.0.0",
    "@rollup/plugin-babel": "^6",
    "@rollup/plugin-commonjs": "^25",
    "@rollup/plugin-eslint": "^9",
    "@rollup/plugin-node-resolve": "^15",
    "@rollup/plugin-replace": "^5",
    "@rollup/plugin-terser": "^0.4.4",
    "@types/jest": "^29.5.14",
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.14.12",
    "autoprefixer": "^9",
    "babel-plugin-macros": "^2.7.0",
    "babel-plugin-transform-async-to-promises": "^0.8.15",
    "babel-plugin-transform-replace-expressions": "^0.2.0",
    "fs": "^0.0.1-security",
    "husky": "^1.3.1",
    "jest": "^29.7.0",
    "rollup-plugin-babel": "latest",
    "rollup-plugin-progress": "^1",
    "standard": "^17.1.0",
    "ts-jest": "^29.2.6",
    "tslib": "^2",
    "typescript": "^4.9.5"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/?(*.)+(spec|test).[tj]s?(x)"
    ],
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    },
    "collectCoverage": true,
    "coverageReporters": [
      "text",
      "lcov"
    ],
    "coverageDirectory": "coverage"
  },
  "engines": {
    "node": ">=16"
  },
  "standard": {
    "ignore": [
      "*.tmp"
    ]
  },
  "files": [
    "typings",
    "dist"
  ],
  "husky": {
    "hooks": {
      "pre-commit": "npm test"
    }
  },
  "license": "MIT"
}
